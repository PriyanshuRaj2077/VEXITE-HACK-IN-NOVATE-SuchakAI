# SuchakAI Environment Configuration
# Copy these into your Vercel Project Settings -> Environment Variables

# --- Google Gemini AI (Required for live Gemini AI Explanations) ---
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# --- Supabase (Optional - for citizen database authentication & cloud sync) ---
# If not provided, SuchakAI operates seamlessly using local offline storage and seed databases.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
